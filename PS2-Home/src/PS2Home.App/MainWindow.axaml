<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
        x:Class="PS2Home.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="700" MinWidth="800" MinHeight="500"
        Background="#0F1117">

  <Window.Styles>
    <Style Selector="Button.nav-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A0A5B5"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.nav-button:pointerover">
      <Setter Property="Background" Value="#202430"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.nav-button:focus-visible">
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#00D4AA"/>
    </Style>

    <Style Selector="Button.nav-button.active">
      <Setter Property="Background" Value="#2A2F3E"/>
      <Setter Property="Foreground" Value="#00D4AA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="220,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#161922" Padding="16" BorderBrush="#2A2F3E" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24" Spacing="4">
          <TextBlock Text="PS2 Home" FontSize="22" FontWeight="Bold" Foreground="#E8E8E8"/>
          <TextBlock Text="Your PS2 Homebrew Launcher" FontSize="12" Opacity="0.6" Foreground="#E8E8E8" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="6" DockPanel.Dock="Top">
          <Button Content="📚  Library"
                  Classes="nav-button"
                  Classes.active="{Binding IsLibraryActive}"
                  Command="{Binding NavigateToLibraryCommand}"/>

          <Button Content="🎮  Controllers"
                  Classes="nav-button"
                  Classes.active="{Binding IsControllersActive}"
                  Command="{Binding NavigateToControllersCommand}"/>

          <Button Content="⚙️  Settings"
                  Classes="nav-button"
                  Classes.active="{Binding IsSettingsActive}"
                  Command="{Binding NavigateToSettingsCommand}"/>

          <Button Content="⬇  Downloads"
                  Classes="nav-button"
                  Classes.active="{Binding IsDownloadsActive}"
                  Command="{Binding NavigateToDownloadsCommand}"/>

          <Button Content="🔧  Diagnostics"
                  Classes="nav-button"
                  Classes.active="{Binding IsDiagnosticsActive}"
                  Command="{Binding NavigateToDiagnosticsCommand}"/>

          <Button Content="ℹ️  About"
                  Classes="nav-button"
                  Classes.active="{Binding IsAboutActive}"
                  Command="{Binding NavigateToAboutCommand}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="v1.0.0"
                   FontSize="11"
                   Opacity="0.4"
                   Foreground="#E8E8E8"
                   HorizontalAlignment="Center"
                   Margin="0,24,0,0"/>
      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <Border Grid.Column="1" Padding="32" Background="#0F1117">
      <ContentControl Content="{Binding CurrentView}"/>
    </Border>
  </Grid>
</Window>
