<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,24">
      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Diagnostics" FontSize="28" FontWeight="Bold" Foreground="#F3E8D0"/>
          <TextBlock Text="System information, health checks, and application logs" FontSize="14" Opacity="0.7" Foreground="#F3E8D0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh information"
                  Command="{Binding RefreshSystemInfoCommand}"
                  Padding="14,8"
                  Background="#4A3A32"
                  Foreground="#F3E8D0"
                  BorderThickness="0"
                  CornerRadius="6"/>
          <Button Content="Run self-test"
                  Command="{Binding RunSelfTestCommand}"
                  Padding="14,8"
                  Background="#C96F4A"
                  Foreground="#171616"
                  FontWeight="SemiBold"
                  BorderThickness="0"
                  CornerRadius="6"/>
        </StackPanel>
      </Grid>

      <!-- System Summary Cards -->
      <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
        <Border Grid.Column="0" Background="#25201D" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#4A3A32">
          <StackPanel Spacing="4">
            <TextBlock Text="App Version" FontSize="12" Opacity="0.6" Foreground="#F3E8D0"/>
            <TextBlock Text="{Binding AppVersion}" FontSize="20" FontWeight="Bold" Foreground="#C96F4A"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#25201D" CornerRadius="8" Padding="16" Margin="4,0,4,0" BorderThickness="1" BorderBrush="#4A3A32">
          <StackPanel Spacing="4">
            <TextBlock Text="Memory Usage" FontSize="12" Opacity="0.6" Foreground="#F3E8D0"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding MemoryUsage}" FontSize="20" FontWeight="Bold" Foreground="#C96F4A"/>
              <TextBlock Text="MB" FontSize="14" Opacity="0.7" Foreground="#F3E8D0" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#25201D" CornerRadius="8" Padding="16" Margin="8,0,0,0" BorderThickness="1" BorderBrush="#4A3A32">
          <StackPanel Spacing="4">
            <TextBlock Text="Health Status" FontSize="12" Opacity="0.6" Foreground="#F3E8D0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" Foreground="#F3E8D0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Native Hardware Capabilities Card -->
      <Border Background="#25201D" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#4A3A32">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Hardware Capability Probe (Native)" FontSize="16" FontWeight="SemiBold" Foreground="#F3E8D0"/>
              <TextBlock Text="Low-level CPU vector extensions and Vulkan graphics driver status" FontSize="12" Opacity="0.7" Foreground="#F3E8D0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{Binding HasNativeData, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#C96F4A|#4A3A32'}"
                    CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding HasNativeData, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Probe Active|Fallback Mode'}"
                         FontSize="10" FontWeight="Bold"
                         Foreground="{Binding HasNativeData, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#171616|#B9AA98'}"/>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <!-- CPU Vector Extensions -->
            <Border Grid.Column="0" Background="#171616" CornerRadius="6" BorderThickness="1" BorderBrush="#4A3A32" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="CPU Instructions (EE/VU Recompiler)" FontSize="13" FontWeight="SemiBold" Foreground="#F3E8D0"/>
                <TextBlock Text="{Binding CpuFeaturesSummary}" FontSize="12" Foreground="#C96F4A" FontFamily="Consolas, Monospace"/>
              </StackPanel>
            </Border>

            <!-- Vulkan Driver -->
            <Border Grid.Column="1" Background="#171616" CornerRadius="6" BorderThickness="1" BorderBrush="#4A3A32" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Vulkan Graphics Driver (PCSX2 Backend)" FontSize="13" FontWeight="SemiBold" Foreground="#F3E8D0"/>
                <TextBlock Text="{Binding VulkanStatusSummary}" FontSize="12"
                           Foreground="{Binding IsVulkanSupported, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#C96F4A|#B94F45'}"
                           FontFamily="Consolas, Monospace" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- System Environment Details -->
      <Border Background="#25201D" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#4A3A32">
        <StackPanel Spacing="12">
          <TextBlock Text="Environment Information" FontSize="16" FontWeight="SemiBold" Foreground="#F3E8D0"/>
          <TextBox Text="{Binding SystemInfo}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="Consolas, Monospace"
                   FontSize="12"
                   Background="#171616"
                   Foreground="#C96F4A"
                   BorderThickness="1"
                   BorderBrush="#4A3A32"
                   CornerRadius="6"
                   Padding="12"
                   MinHeight="140"/>
        </StackPanel>
      </Border>

      <!-- Activity Logs -->
      <Border Background="#25201D" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#4A3A32">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Session Logs" FontSize="16" FontWeight="SemiBold" Foreground="#F3E8D0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Export launch logs"
                      Command="{Binding ExportRedactedLogsCommand}"
                      Padding="12,6"
                      Background="#4A3A32"
                      Foreground="#C96F4A"
                      BorderThickness="0"
                      CornerRadius="6"
                      FontSize="12"/>
              <Button Content="Clear Logs"
                      Command="{Binding ClearLogsCommand}"
                      Padding="12,6"
                      Background="Transparent"
                      Foreground="#B9AA98"
                      BorderThickness="1"
                      BorderBrush="#4A3A32"
                      CornerRadius="6"
                      FontSize="12"/>
            </StackPanel>
          </Grid>

          <Border Background="#171616" CornerRadius="6" BorderThickness="1" BorderBrush="#4A3A32" Padding="12" MinHeight="160" MaxHeight="260">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding LogEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="Consolas, Monospace"
                               FontSize="12"
                               Foreground="#F3E8D0"
                               Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
