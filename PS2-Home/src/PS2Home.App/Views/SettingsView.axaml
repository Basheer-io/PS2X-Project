<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             xmlns:core="clr-namespace:PS2Home.Core;assembly=PS2Home.Core"
             x:Class="PS2Home.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,24">
      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Settings &amp; Setup Assistant" FontSize="28" FontWeight="Bold" Foreground="#F4F0E6"/>
        <TextBlock Text="Configure PCSX2 emulator integration, game directories, couch layout, and backups" FontSize="14" Opacity="0.7" Foreground="#F4F0E6"/>
      </StackPanel>

      <!-- PCSX2 Setup Assistant Card -->
      <Border Background="#211E1A" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A332B">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="PCSX2 Integration" FontSize="18" FontWeight="Bold" Foreground="#F4F0E6"/>
              <TextBlock Text="PS2 Home launches your games using your installed PCSX2 emulator" FontSize="12" Opacity="0.7" Foreground="#F4F0E6"/>
            </StackPanel>

            <!-- Status Badge -->
            <Border Grid.Column="1"
                    Background="{Binding IsPcsx2Configured, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#D97757|#D95D54'}"
                    CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
              <TextBlock Text="{Binding IsPcsx2Configured, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Ready|Setup Required'}"
                         FontSize="11" FontWeight="Bold" Foreground="#171513"/>
            </Border>
          </Grid>

          <!-- Native execution boundary -->
          <Border Background="#2B2520" BorderBrush="#B9855A" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="How games run" FontSize="14" FontWeight="Bold" Foreground="#E2B978"/>
              <TextBlock Text="PS2 games cannot run directly on a normal PC. This launcher starts them through PCSX2, which emulates the PlayStation 2 hardware. A real PS2 console or a PS2-specific native port would be required for native execution."
                         FontSize="12" Opacity="0.9" Foreground="#F4F0E6" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Status / Version readout -->
          <Border Background="#171513" CornerRadius="6" BorderBrush="#3A332B" BorderThickness="1" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Pcsx2StatusText}" FontSize="13" Foreground="#F4F0E6" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Pcsx2VersionText}" FontSize="12" Foreground="#D97757" FontFamily="Consolas, Monospace"
                         IsVisible="{Binding Pcsx2VersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <!-- Auto-Detection Trigger -->
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Detected Installations" FontSize="14" FontWeight="SemiBold" Foreground="#F4F0E6" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="🔍 Scan for PCSX2"
                    Command="{Binding DetectPcsx2Command}"
                    IsEnabled="{Binding !IsDetecting}"
                    Padding="14,8"
                    Background="#3A332B"
                    Foreground="#F4F0E6"
                    BorderThickness="0"
                    CornerRadius="6"/>
            <Button Grid.Column="2"
                    Content="Open PCSX2"
                    Command="{Binding OpenPcsx2Command}"
                    IsEnabled="{Binding IsPcsx2Configured}"
                    Padding="14,8"
                    Background="#D97757"
                    Foreground="#171513"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    CornerRadius="6"/>
          </Grid>

          <!-- Installations Dropdown -->
          <ComboBox ItemsSource="{Binding DetectedInstallations}"
                    SelectedItem="{Binding SelectedInstallation}"
                    HorizontalAlignment="Stretch"
                    Background="#171513"
                    Foreground="#F4F0E6"
                    BorderBrush="#3A332B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:Pcsx2Installation">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F4F0E6"/>
                  <TextBlock Text="{Binding Version}" Foreground="#D97757" FontFamily="Consolas, Monospace" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Manual Path Override -->
          <StackPanel Spacing="6">
            <TextBlock Text="Or specify custom binary / AppImage path:" FontSize="13" Opacity="0.8" Foreground="#F4F0E6"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding CustomPcsx2Path}"
                       Watermark="/usr/bin/pcsx2-qt, ~/Applications/PCSX2.AppImage, or C:\PCSX2\pcsx2-qt.exe..."
                       Background="#171513"
                       Foreground="#F4F0E6"
                       BorderBrush="#3A332B"
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="12,8"
                       FontFamily="Consolas, Monospace"
                       FontSize="13"/>
              <Button Grid.Column="1"
                       Content="Test binary"
                       Command="{Binding ValidateCustomPathCommand}"
                       IsEnabled="{Binding !IsValidating}"
                       Padding="16,8"
                       Background="#D97757"
                       Foreground="#171513"
                       FontWeight="SemiBold"
                       BorderThickness="0"
                       CornerRadius="6"/>
            </Grid>
          </StackPanel>

          <!-- BIOS Guidance Box -->
          <Border Background="#2B2520" BorderBrush="#B9855A" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="PlayStation 2 BIOS requirement" FontSize="14" FontWeight="Bold" Foreground="#E2B978"/>
              <TextBlock Text="PCSX2 requires a genuine BIOS dump from your own PlayStation 2 console to run commercial games. PS2 Home does not and will never distribute, bundle, or download BIOS files."
                         FontSize="12" Opacity="0.85" Foreground="#F4F0E6" TextWrapping="Wrap"/>
              <TextBlock Text="Learn how to legally dump your PS2 BIOS at: https://pcsx2.net/docs/setup/bios/"
                         FontSize="12" Foreground="#B9855A" TextWrapping="Wrap" FontFamily="Consolas, Monospace"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Game Library Folders -->
      <Border Background="#211E1A" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A332B">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="PS2 Game Directories" FontSize="16" FontWeight="SemiBold" Foreground="#F4F0E6"/>
            <TextBlock Text="Folders scanned recursively for PlayStation 2 disc images (.iso)" FontSize="12" Opacity="0.7" Foreground="#F4F0E6"/>
          </StackPanel>

          <!-- Add Folder Input -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewFolderPath}"
                     Watermark="Enter directory path (e.g. /home/user/Games/PS2 or D:\PS2Games)..."
                     Background="#171513"
                     Foreground="#F4F0E6"
                     BorderBrush="#3A332B"
                     BorderThickness="1"
                     CornerRadius="6"
                     Padding="12,8"
                     FontFamily="Consolas, Monospace"
                     FontSize="13"/>
            <Button Grid.Column="1"
                    Content="Add folder"
                    Command="{Binding AddFolderCommand}"
                    Padding="16,8"
                    Background="#D97757"
                    Foreground="#171513"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    CornerRadius="6"/>
          </Grid>

          <!-- Configured Folders List -->
          <Border Background="#171513" CornerRadius="6" BorderBrush="#3A332B" BorderThickness="1" Padding="8" MinHeight="80">
            <ItemsControl ItemsSource="{Binding GameFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding}"
                               Foreground="#F4F0E6"
                               FontFamily="Consolas, Monospace"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Remove"
                            Command="{Binding $parent[UserControl].DataContext.RemoveFolderCommand}"
                            CommandParameter="{Binding}"
                            Padding="8,4"
                            Background="#3A332B"
                            Foreground="#D95D54"
                            BorderThickness="0"
                            CornerRadius="4"
                            FontSize="11"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <!-- Backup & Restore Card -->
      <Border Background="#211E1A" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A332B">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="💾 Backup &amp; Restore" FontSize="18" FontWeight="Bold" Foreground="#F4F0E6"/>
              <TextBlock Text="Export your settings and game library to a JSON backup file, or restore an existing backup" FontSize="12" Opacity="0.7" Foreground="#F4F0E6"/>
            </StackPanel>
          </Grid>

          <Border Background="#171513" CornerRadius="6" BorderBrush="#3A332B" BorderThickness="1" Padding="12">
            <TextBlock Text="{Binding BackupStatusMessage}" FontSize="13" Foreground="#F4F0E6" TextWrapping="Wrap"/>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ExportBackupButton"
                    Content="Export backup..."
                    Click="OnExportBackupClick"
                    IsEnabled="{Binding !IsBackingUp}"
                    Padding="16,10"
                    Background="#3A332B"
                    Foreground="#F4F0E6"
                    BorderThickness="0"
                    CornerRadius="6"
                    FontWeight="SemiBold"/>

            <Button x:Name="ImportBackupButton"
                    Content="Restore backup..."
                    Click="OnImportBackupClick"
                    IsEnabled="{Binding !IsBackingUp}"
                    Padding="16,10"
                    Background="#3A332B"
                    Foreground="#D97757"
                    BorderThickness="1"
                    BorderBrush="#D97757"
                    CornerRadius="6"
                    FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- General Options -->
      <Border Background="#211E1A" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A332B">
        <StackPanel Spacing="16">
          <TextBlock Text="General &amp; Layout" FontSize="16" FontWeight="SemiBold" Foreground="#F4F0E6"/>
          <StackPanel Spacing="12">
            <CheckBox Content="Auto-scan on application startup" IsChecked="{Binding AutoScanOnStartup}" Foreground="#F4F0E6" FontSize="14"/>
            <CheckBox Content="Show missing or moved game images" IsChecked="{Binding ShowHiddenApps}" Foreground="#F4F0E6" FontSize="14"/>
            <CheckBox Content="Couch mode (enlarged TV layout)" IsChecked="{Binding CouchMode}" Foreground="#F4F0E6" FontSize="14"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <Border Background="#211E1A" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A332B">
        <StackPanel Spacing="12">
          <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="#F4F0E6"/>
          <ComboBox SelectedItem="{Binding Theme}"
                    Background="#171513"
                    Foreground="#F4F0E6"
                    BorderBrush="#3A332B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
            <ComboBoxItem Content="Dark" Foreground="#F4F0E6"/>
            <ComboBoxItem Content="Light" Foreground="#F4F0E6"/>
            <ComboBoxItem Content="System" Foreground="#F4F0E6"/>
          </ComboBox>
        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Reset to Defaults"
                Command="{Binding ResetToDefaultsCommand}"
                Padding="16,10"
                Background="Transparent"
                Foreground="#F4F0E6"
                BorderBrush="#3A332B"
                BorderThickness="1"
                CornerRadius="6"/>
        <Button Content="Save Settings"
                Command="{Binding SaveSettingsCommand}"
                Padding="24,10"
                Background="#D97757"
                Foreground="#171513"
                BorderThickness="0"
                CornerRadius="6"
                FontWeight="SemiBold"/>
      </StackPanel>

      <!-- Status Message -->
      <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#D97757" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
