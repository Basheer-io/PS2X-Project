<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,24">
      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
        <TextBlock Text="Configure library game folders and scanner preferences" FontSize="14" Opacity="0.7" Foreground="#E8E8E8"/>
      </StackPanel>

      <!-- Game Library Folders -->
      <Border Background="#161922" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#2A2F3E">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="PS2 Game Directories" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>
            <TextBlock Text="Folders scanned recursively for PlayStation 2 disc images (.iso)" FontSize="12" Opacity="0.7" Foreground="#E8E8E8"/>
          </StackPanel>

          <!-- Add Folder Input -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewFolderPath}"
                     Watermark="Enter directory path (e.g. /home/user/Games/PS2 or D:\PS2Games)..."
                     Background="#0F1117"
                     Foreground="#E8E8E8"
                     BorderBrush="#2A2F3E"
                     BorderThickness="1"
                     CornerRadius="6"
                     Padding="12,8"
                     FontFamily="Consolas, Monospace"
                     FontSize="13"/>
            <Button Grid.Column="1"
                    Content="➕ Add Folder"
                    Command="{Binding AddFolderCommand}"
                    Padding="16,8"
                    Background="#00D4AA"
                    Foreground="#0F1117"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    CornerRadius="6"/>
          </Grid>

          <!-- Configured Folders List -->
          <Border Background="#0F1117" CornerRadius="6" BorderBrush="#2A2F3E" BorderThickness="1" Padding="8" MinHeight="80">
            <ItemsControl ItemsSource="{Binding GameFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding}"
                               Foreground="#E8E8E8"
                               FontFamily="Consolas, Monospace"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕ Remove"
                            Command="{Binding $parent[UserControl].DataContext.RemoveFolderCommand}"
                            CommandParameter="{Binding}"
                            Padding="8,4"
                            Background="#2A2F3E"
                            Foreground="#FF6B6B"
                            BorderThickness="0"
                            CornerRadius="4"
                            FontSize="11"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <!-- Cover Art Path -->
      <Border Background="#161922" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#2A2F3E">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Cover Art Folder" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>
            <TextBlock Text="Directory containing artwork and screenshots (Phase 6)" FontSize="12" Opacity="0.7" Foreground="#E8E8E8"/>
          </StackPanel>
          <TextBox Text="{Binding CoverArtPath}"
                   Background="#0F1117"
                   Foreground="#E8E8E8"
                   BorderBrush="#2A2F3E"
                   BorderThickness="1"
                   CornerRadius="4"
                   Padding="12,8"
                   FontFamily="Consolas, Monospace"
                   FontSize="13"/>
        </StackPanel>
      </Border>

      <!-- General Options -->
      <Border Background="#161922" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#2A2F3E">
        <StackPanel Spacing="16">
          <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>
          <StackPanel Spacing="12">
            <CheckBox Content="Auto-scan on application startup" IsChecked="{Binding AutoScanOnStartup}" Foreground="#E8E8E8" FontSize="14"/>
            <CheckBox Content="Show missing or moved game images" IsChecked="{Binding ShowHiddenApps}" Foreground="#E8E8E8" FontSize="14"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <Border Background="#161922" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#2A2F3E">
        <StackPanel Spacing="12">
          <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>
          <ComboBox SelectedItem="{Binding Theme}"
                    Background="#0F1117"
                    Foreground="#E8E8E8"
                    BorderBrush="#2A2F3E"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
            <ComboBoxItem Content="Dark" Foreground="#E8E8E8"/>
            <ComboBoxItem Content="Light" Foreground="#E8E8E8"/>
            <ComboBoxItem Content="System" Foreground="#E8E8E8"/>
          </ComboBox>
        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Reset to Defaults"
                Command="{Binding ResetToDefaultsCommand}"
                Padding="16,10"
                Background="Transparent"
                Foreground="#E8E8E8"
                BorderBrush="#2A2F3E"
                BorderThickness="1"
                CornerRadius="6"/>
        <Button Content="Save Settings"
                Command="{Binding SaveSettingsCommand}"
                Padding="24,10"
                Background="#00D4AA"
                Foreground="#0F1117"
                BorderThickness="0"
                CornerRadius="6"
                FontWeight="SemiBold"/>
      </StackPanel>

      <!-- Status Message -->
      <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#00D4AA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
