<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <!-- ListBoxItem styling for seamless card layout -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Game Card Base -->
    <Style Selector="Border.game-card">
      <Setter Property="Width" Value="260"/>
      <Setter Property="Height" Value="350"/>
      <Setter Property="Background" Value="#25201D"/>
      <Setter Property="BorderBrush" Value="#4A3A32"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Couch Mode (10-foot UI) -->
    <Style Selector="Border.game-card.couch">
      <Setter Property="Width" Value="340"/>
      <Setter Property="Height" Value="430"/>
    </Style>

    <!-- Focused / Selected Card Highlight -->
    <Style Selector="ListBoxItem:focus-visible Border.game-card">
      <Setter Property="BorderBrush" Value="#C96F4A"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.game-card">
      <Setter Property="BorderBrush" Value="#C96F4A"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.couch-toggle.active">
      <Setter Property="Background" Value="#C96F4A"/>
      <Setter Property="Foreground" Value="#171616"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#C96F4A"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Library" FontSize="30" FontWeight="Bold" Foreground="#F3E8D0"/>
          <TextBlock Text="{Binding StatusMessage}" FontSize="13" Opacity="0.7" Foreground="#B9AA98"/>
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,5,0,0">
            <TextBlock Text="{Binding TotalApps, StringFormat='{}{0} games'}"
                       FontSize="11" Foreground="#C96F4A"/>
            <TextBlock Text="{Binding InstalledApps, StringFormat='{}{0} ready'}"
                       FontSize="11" Foreground="#B9AA98"/>
            <TextBlock Text="{Binding MissingApps, StringFormat='{}{0} missing'}"
                       FontSize="11" Foreground="#B94F45"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Couch mode"
                  Command="{Binding ToggleCouchModeCommand}"
                  Classes="couch-toggle"
                  Classes.active="{Binding CouchMode}"
                  Padding="14,9"
                  Background="#4A3A32"
                  Foreground="#F3E8D0"
                  FontSize="12"
                  BorderThickness="0"
                  CornerRadius="6"
                  ToolTip.Tip="Toggle 10-foot enlarged layout for TV / gamepad use"/>
          <Button Content="Cancel"
                  Command="{Binding CancelScanCommand}"
                  IsVisible="{Binding IsScanning}"
                  Padding="16,9"
                  Background="#B94F45"
                  Foreground="#171616"
                  FontWeight="SemiBold"
                  BorderThickness="0"
                  CornerRadius="6"/>
          <Button Content="Rescan library"
                  Command="{Binding RescanLibraryCommand}"
                  IsVisible="{Binding !IsScanning}"
                  Padding="16,9"
                  Background="#4A3A32"
                  Foreground="#F3E8D0"
                  BorderThickness="0"
                  CornerRadius="6"
                  IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Search Box -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 x:Name="SearchTextBox"
                 Text="{Binding SearchText}"
                 Watermark="Search your games..."
                 Background="#25201D"
                 Foreground="#F3E8D0"
                 BorderBrush="#4A3A32"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="13,11"
                 FontSize="13"/>
        <ComboBox Grid.Column="1"
                 ItemsSource="{Binding SortModes}"
                 SelectedItem="{Binding SortMode}"
                 Width="150"
                 Background="#25201D"
                 Foreground="#F3E8D0"
                 BorderBrush="#4A3A32"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="10,8"
                 ToolTip.Tip="Sort the library"/>
        <ComboBox Grid.Column="2"
                 ItemsSource="{Binding FilterModes}"
                 SelectedItem="{Binding FilterMode}"
                 Width="125"
                 Background="#25201D"
                 Foreground="#F3E8D0"
                 BorderBrush="#4A3A32"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="10,8"
                 ToolTip.Tip="Filter ready or missing games"/>
        <Button Grid.Column="3"
                Content="Clear search"
                Command="{Binding ClearSearchCommand}"
                IsVisible="{Binding HasSearchQuery}"
                Margin="8,0,0,0"
                Padding="13,9"
                Background="#4A3A32"
                Foreground="#F3E8D0"
                BorderThickness="0"
                CornerRadius="6"/>
      </Grid>
    </Border>

    <!-- First-run onboarding -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsSetupNeeded}"
            Margin="0,0,0,16"
            Padding="18"
            Background="#30251F"
            BorderBrush="#C96F4A"
            BorderThickness="1"
            CornerRadius="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="38" Height="38" CornerRadius="19" Background="#C96F4A" VerticalAlignment="Top">
          <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#171616"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Finish setting up your library" FontSize="16" FontWeight="Bold" Foreground="#F3E8D0"/>
          <TextBlock Text="Connect PCSX2 and add a game folder in Settings. Then scan here to build your collection."
                     FontSize="12" Foreground="#E8D8C4" TextWrapping="Wrap"/>
          <TextBlock Text="Ctrl+O opens Settings · R rescans the library" FontSize="11" Foreground="#C96F4A"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Open Settings"
                Click="OnOpenSettingsClick"
                Padding="14,9"
                Background="#C96F4A"
                Foreground="#171616"
                FontWeight="SemiBold"
                BorderThickness="0"
                CornerRadius="6"
                ToolTip.Tip="Configure PCSX2 and game folders"/>
      </Grid>
    </Border>

    <!-- Active Scanning Progress Banner -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsScanning}"
            Margin="0,0,0,16"
            Padding="20"
            Background="#25201D"
            BorderBrush="#C96F4A"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="Scanning" FontSize="12" Foreground="#B9AA98" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ScanProgressMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#C96F4A"/>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Width="280" Height="4" Background="#4A3A32" Foreground="#C96F4A"/>
      </StackPanel>
    </Border>

    <!-- Initial Loading State -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsLoading}"
            Margin="0,0,0,16"
            Padding="24"
            Background="#25201D"
            CornerRadius="8">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="#4A3A32" Foreground="#C96F4A"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#F3E8D0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Error State / Crash Banner -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,16"
            Padding="20"
            Background="#3A211F"
            BorderBrush="#B94F45"
            BorderThickness="1"
            CornerRadius="8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Something went wrong" FontSize="16" FontWeight="Bold" Foreground="#B94F45"/>
          <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#F3E8D0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Dismiss"
                Command="{Binding ToggleErrorStateCommand}"
                Padding="16,8"
                Background="#B94F45"
                Foreground="#171616"
                FontWeight="SemiBold"
                BorderThickness="0"
                CornerRadius="6"/>
      </Grid>
    </Border>

    <!-- Recently Played Row -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasRecentApps}"
            Margin="0,0,0,20"
            Padding="16"
            Background="#25201D"
            BorderBrush="#4A3A32"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Recently Played" FontSize="16" FontWeight="Bold" Foreground="#F3E8D0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Jump right back in" FontSize="12" Opacity="0.6" Foreground="#F3E8D0" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentApps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AppItemViewModel">
                <Border Width="220" Background="#171616" BorderBrush="#4A3A32" BorderThickness="1" CornerRadius="8" Padding="12">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <!-- Title & Last Played -->
                    <StackPanel Grid.Row="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F3E8D0"
                                 TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Text="{Binding FormattedLastPlayed}" FontSize="11" Foreground="#C96F4A"/>
                    </StackPanel>

                    <!-- Launch Button -->
                    <Button Grid.Row="1"
                            Content="{Binding LaunchButtonText}"
                            Command="{Binding $parent[UserControl].DataContext.LaunchAppCommand}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,6"
                            Background="#C96F4A"
                            Foreground="#171616"
                            FontWeight="SemiBold"
                            FontSize="12"
                            CornerRadius="4"
                            IsEnabled="{Binding CanLaunch}"/>
                  </Grid>
                </Border>

              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Selected Game Details -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasSelectedApp}"
            Margin="0,0,0,20"
            Padding="16"
            Background="#25201D"
            BorderBrush="#4A3A32"
            BorderThickness="1"
            CornerRadius="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="SELECTED GAME" Classes="eyebrow"/>
          <TextBlock Text="{Binding SelectedApp.Name}" FontSize="20" FontWeight="Bold" Foreground="#F3E8D0"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding SelectedApp.FullPath}" FontSize="11" Foreground="#B9AA98"
                     FontFamily="Consolas, Monospace" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <TextBlock Text="{Binding SelectedApp.FormattedSize}" FontSize="12" Foreground="#C96F4A"/>
            <TextBlock Text="{Binding SelectedApp.FormattedLastPlayed}" FontSize="12" Foreground="#B9AA98"/>
            <TextBlock Text="{Binding SelectedApp.Status}" FontSize="12" Foreground="#B9AA98"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Set cover"
                  Click="OnSelectedSetCoverClick"
                  Padding="12,8"
                  Background="#4A3A32"
                  Foreground="#F3E8D0"
                  BorderThickness="0"
                  CornerRadius="6"
                  ToolTip.Tip="Choose custom cover art"/>
          <Button Content="{Binding SelectedApp.LaunchButtonText}"
                  Command="{Binding LaunchAppCommand}"
                  CommandParameter="{Binding SelectedApp}"
                  IsEnabled="{Binding SelectedApp.CanLaunch}"
                  Padding="14,8"
                  Background="#C96F4A"
                  Foreground="#171616"
                  FontWeight="SemiBold"
                  BorderThickness="0"
                  CornerRadius="6"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Empty State -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsEmpty}"
            Padding="56"
            Background="#25201D"
            BorderBrush="#4A3A32"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <TextBlock Text="Your library is empty" FontSize="20" FontWeight="SemiBold" Foreground="#F3E8D0" HorizontalAlignment="Center"/>
        <TextBlock Text="Add a game folder in Settings, then rescan for .iso files."
                   FontSize="14" Opacity="0.7" Foreground="#F3E8D0" HorizontalAlignment="Center" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="Clear filter"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding HasSearchQuery}"
                  Padding="16,10"
                  Background="#4A3A32"
                  Foreground="#F3E8D0"
                  BorderThickness="0"
                  CornerRadius="6"
                  FontWeight="SemiBold"/>
          <Button Content="Rescan folders"
                  Command="{Binding RescanLibraryCommand}"
                  Padding="16,10"
                  Background="#C96F4A"
                  Foreground="#171616"
                  BorderThickness="0"
                  CornerRadius="6"
                  FontWeight="SemiBold"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Games Grid (ListBox for native keyboard navigation) -->
    <ScrollViewer DockPanel.Dock="Top"
                  IsVisible="{Binding HasApps}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ListBox ItemsSource="{Binding Apps}"
               SelectedItem="{Binding SelectedApp}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Classes="game-card"
                    Classes.couch="{Binding $parent[UserControl].DataContext.CouchMode}"
                    ClipToBounds="True">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Launch"
                            Click="OnContextLaunchClick"
                            IsEnabled="{Binding CanLaunch}"/>
                  <MenuItem Header="Set cover art"
                            Click="OnContextSetCoverClick"/>
                  <MenuItem Header="Remove cover art"
                            Click="OnContextRemoveCoverClick"
                            IsVisible="{Binding HasCoverArt}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid RowDefinitions="180,*,Auto">
                <!-- Cover Art / Fallback Image Area -->
                <Border Grid.Row="0"
                        Background="#171616"
                        CornerRadius="12,12,0,0"
                        ClipToBounds="True">
                  <Grid>
                    <!-- User Cover Art Image -->
                    <Image Source="{Binding CoverArtPath, Converter={StaticResource PathToBitmapConverter}}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding HasCoverArt}"/>

                    <!-- Graceful Fallback Disc Tile -->
                    <Grid IsVisible="{Binding !HasCoverArt}">
                      <TextBlock Text="No cover" FontSize="12" Foreground="#B9AA98"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Cover Art Management Tools (Top Left) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                      <Button Content="Cover"
                              ToolTip.Tip="Set or change cover art"
                              Click="OnSetCoverClick"
                              Padding="6,4"
                              Background="#30000000"
                              Foreground="#F3E8D0"
                              BorderThickness="0"
                              CornerRadius="4"
                              FontSize="12"/>
                      <Button Content="Remove"
                              ToolTip.Tip="Remove cover art"
                              Click="OnRemoveCoverClick"
                              IsVisible="{Binding HasCoverArt}"
                              Padding="6,4"
                              Background="#30000000"
                              Foreground="#B94F45"
                              BorderThickness="0"
                              CornerRadius="4"
                              FontSize="12"/>
                    </StackPanel>

                    <!-- Running / Missing Status Badge (Top Right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="{Binding !IsMissing, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#C96F4A|#B94F45'}"
                            CornerRadius="10" Padding="8,3">
                      <TextBlock Text="{Binding !IsMissing, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Ready|Missing'}"
                                 FontSize="10" FontWeight="Bold" Foreground="#171616"/>
                    </Border>

                    <!-- File Size & Last Played Badge (Bottom) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                            Background="#80000000" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#B9AA98" FontFamily="Consolas, Monospace"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- Game Info -->
                <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#F3E8D0"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding FormattedLastPlayed}" FontSize="11" Foreground="#C96F4A" Opacity="0.9"/>
                  <TextBlock Text="{Binding FullPath}" FontSize="11" Opacity="0.6" Foreground="#F3E8D0"
                             TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontFamily="Consolas, Monospace"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="16,0,16,16" HorizontalAlignment="Stretch">
                  <Button Content="{Binding LaunchButtonText}"
                          Command="{Binding $parent[UserControl].DataContext.LaunchAppCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="0,10"
                          Background="{Binding CanLaunch, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#C96F4A|#4A3A32'}"
                          Foreground="{Binding CanLaunch, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#171616|#B9AA98'}"
                          BorderThickness="0"
                          CornerRadius="6"
                          FontWeight="SemiBold"
                          FontSize="13"
                          IsEnabled="{Binding CanLaunch}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>

    <!-- Stats Footer -->
    <Border DockPanel.Dock="Bottom" Margin="0,24,0,0" Padding="16" Background="#25201D" CornerRadius="8">
      <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TotalApps}" FontSize="24" FontWeight="Bold" Foreground="#C96F4A" HorizontalAlignment="Center"/>
          <TextBlock Text="Total Games" FontSize="12" Opacity="0.7" Foreground="#F3E8D0" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="#4A3A32" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding InstalledApps}" FontSize="24" FontWeight="Bold" Foreground="#C96F4A" HorizontalAlignment="Center"/>
          <TextBlock Text="Ready" FontSize="12" Opacity="0.7" Foreground="#F3E8D0" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Width="1" Background="#4A3A32" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding MissingApps}" FontSize="24" FontWeight="Bold" Foreground="#B94F45" HorizontalAlignment="Center"/>
          <TextBlock Text="Missing / Moved" FontSize="12" Opacity="0.7" Foreground="#F3E8D0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
