<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,24">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Library" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
          <TextBlock Text="{Binding StatusMessage}" FontSize="14" Opacity="0.7" Foreground="#E8E8E8"/>
        </StackPanel>
        <Button Grid.Column="1" 
                Content="🔄 Refresh" 
                Command="{Binding RefreshLibraryCommand}"
                Padding="16,8"
                Background="#2A2F3E"
                Foreground="#E8E8E8"
                BorderThickness="0"
                CornerRadius="6"
                HorizontalAlignment="Right"
                IsEnabled="{Binding !IsLoading}"/>
      </Grid>
    </Border>

    <!-- Loading State -->
    <Border DockPanel.Dock="Top" 
            IsVisible="{Binding IsLoading}"
            Margin="0,0,0,16"
            Padding="24"
            Background="#161922"
            CornerRadius="8">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="#2A2F3E" Foreground="#00D4AA"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Empty State -->
    <Border DockPanel.Dock="Top" 
            IsVisible="{Binding !IsLoading && TotalApps == 0}"
            Padding="48"
            Background="#161922"
            CornerRadius="8">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
        <TextBlock Text="No PS2 Applications Found" FontSize="20" FontWeight="SemiBold" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        <TextBlock Text="Click Refresh to scan for installed homebrew applications" FontSize="14" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center" TextAlignment="Center"/>
        <Button Content="🔄 Scan Now" 
                Command="{Binding RefreshLibraryCommand}"
                Padding="24,12"
                Background="#00D4AA"
                Foreground="#0F1117"
                BorderThickness="0"
                CornerRadius="6"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Apps Grid -->
    <ScrollViewer DockPanel.Dock="Top" 
                  IsVisible="{Binding !IsLoading && TotalApps > 0}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Apps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Width="260" Height="340" 
                    Background="#161922" 
                    CornerRadius="12" 
                    BorderThickness="1"
                    BorderBrush="#2A2F3E"
                    ClipToBounds="True">
              <Grid RowDefinitions="180,*,Auto">
                <!-- Cover Art / Placeholder -->
                <Border Grid.Row="0" 
                        Background="#0F1117"
                        CornerRadius="12,12,0,0">
                  <Grid>
                    <!-- Placeholder Icon -->
                    <TextBlock Text="🎮" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                    <!-- Install Status Badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Background="{Binding IsInstalled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#00D4AA|#FF6B6B'}"
                            CornerRadius="12" Padding="8,4">
                      <TextBlock Text="{Binding IsInstalled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Installed|Not Installed'}" 
                                 FontSize="10" FontWeight="Bold" Foreground="#0F1117"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- App Info -->
                <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#E8E8E8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Tagline}" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ConfigFolderName}" FontSize="10" Opacity="0.5" Foreground="#E8E8E8" FontFamily="Consolas, Monospace"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="16,0,16,16" HorizontalAlignment="Stretch">
                  <Button Content="{Binding IsInstalled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Launch|Install'}" 
                          Command="{Binding $parent[UserControl].DataContext.LaunchAppCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="0,10"
                          Background="{Binding IsInstalled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#00D4AA|#2A2F3E'}"
                          Foreground="{Binding IsInstalled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#0F1117|#E8E8E8'}"
                          BorderThickness="0"
                          CornerRadius="6"
                          FontWeight="SemiBold"
                          FontSize="13"
                          IsEnabled="{Binding IsInstalled}"/>
                  <Button Content="⋮" 
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="0,10"
                          Width="48"
                          Background="#2A2F3E"
                          Foreground="#E8E8E8"
                          BorderThickness="0"
                          CornerRadius="6"
                          FontSize="18"
                          FontWeight="Bold"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Stats Footer -->
    <Border DockPanel.Dock="Bottom" Margin="0,24,0,0" Padding="16" Background="#161922" CornerRadius="8">
      <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TotalApps}" FontSize="24" FontWeight="Bold" Foreground="#00D4AA" HorizontalAlignment="Center"/>
          <TextBlock Text="Total Apps" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="#2A2F3E" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding InstalledApps}" FontSize="24" FontWeight="Bold" Foreground="#00D4AA" HorizontalAlignment="Center"/>
          <TextBlock Text="Installed" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Width="1" Background="#2A2F3E" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TotalApps, Converter={StaticResource SubtractConverter}, ConverterParameter={Binding InstalledApps}}" FontSize="24" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
          <TextBlock Text="Available" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>