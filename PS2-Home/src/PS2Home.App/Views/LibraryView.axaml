<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <UserControl.Styles>
    <!-- ListBoxItem styling for seamless card layout -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Game Card Base -->
    <Style Selector="Border.game-card">
      <Setter Property="Width" Value="260"/>
      <Setter Property="Height" Value="350"/>
      <Setter Property="Background" Value="#161922"/>
      <Setter Property="BorderBrush" Value="#2A2F3E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Couch Mode (10-foot UI) -->
    <Style Selector="Border.game-card.couch">
      <Setter Property="Width" Value="340"/>
      <Setter Property="Height" Value="430"/>
    </Style>

    <!-- Focused / Selected Card Highlight -->
    <Style Selector="ListBoxItem:focus-visible Border.game-card">
      <Setter Property="BorderBrush" Value="#00D4AA"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.game-card">
      <Setter Property="BorderBrush" Value="#00D4AA"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.couch-toggle.active">
      <Setter Property="Background" Value="#00D4AA"/>
      <Setter Property="Foreground" Value="#0F1117"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Library" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
          <TextBlock Text="{Binding StatusMessage}" FontSize="14" Opacity="0.7" Foreground="#E8E8E8"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="🛋️ Couch Mode"
                  Command="{Binding ToggleCouchModeCommand}"
                  Classes="couch-toggle"
                  Classes.active="{Binding CouchMode}"
                  Padding="14,8"
                  Background="#2A2F3E"
                  Foreground="#E8E8E8"
                  FontSize="12"
                  BorderThickness="0"
                  CornerRadius="6"
                  ToolTip.Tip="Toggle 10-foot enlarged layout for TV / gamepad use"/>
          <Button Content="⚠️ Toggle Error"
                  Command="{Binding ToggleErrorStateCommand}"
                  Padding="12,8"
                  Background="#2A2F3E"
                  Foreground="#A0A5B5"
                  FontSize="12"
                  BorderThickness="0"
                  CornerRadius="6"
                  ToolTip.Tip="Demonstrates error state UI"/>
          <Button Content="⏹ Cancel"
                  Command="{Binding CancelScanCommand}"
                  IsVisible="{Binding IsScanning}"
                  Padding="16,8"
                  Background="#FF6B6B"
                  Foreground="#0F1117"
                  FontWeight="SemiBold"
                  BorderThickness="0"
                  CornerRadius="6"/>
          <Button Content="🔄 Rescan Library"
                  Command="{Binding RescanLibraryCommand}"
                  IsVisible="{Binding !IsScanning}"
                  Padding="16,8"
                  Background="#2A2F3E"
                  Foreground="#E8E8E8"
                  BorderThickness="0"
                  CornerRadius="6"
                  IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Search Box -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 x:Name="SearchTextBox"
                 Text="{Binding SearchText}"
                 Watermark="🔍 Search games (Esc to clear, Arrow keys to navigate, Enter to play)..."
                 Background="#161922"
                 Foreground="#E8E8E8"
                 BorderBrush="#2A2F3E"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="12,10"
                 FontSize="13"/>
        <Button Grid.Column="1"
                Content="✕ Clear"
                Command="{Binding ClearSearchCommand}"
                IsVisible="{Binding HasSearchQuery}"
                Margin="8,0,0,0"
                Padding="12,8"
                Background="#2A2F3E"
                Foreground="#E8E8E8"
                BorderThickness="0"
                CornerRadius="6"/>
      </Grid>
    </Border>

    <!-- Active Scanning Progress Banner -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsScanning}"
            Margin="0,0,0,16"
            Padding="20"
            Background="#161922"
            BorderBrush="#00D4AA"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ScanProgressMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#00D4AA"/>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Width="280" Height="4" Background="#2A2F3E" Foreground="#00D4AA"/>
      </StackPanel>
    </Border>

    <!-- Initial Loading State -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsLoading}"
            Margin="0,0,0,16"
            Padding="24"
            Background="#161922"
            CornerRadius="8">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Background="#2A2F3E" Foreground="#00D4AA"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Error State / Crash Banner -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,16"
            Padding="20"
            Background="#2B141B"
            BorderBrush="#FF6B6B"
            BorderThickness="1"
            CornerRadius="8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="⚠️ Notice / Error" FontSize="16" FontWeight="Bold" Foreground="#FF6B6B"/>
          <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#E8E8E8" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Dismiss"
                Command="{Binding ToggleErrorStateCommand}"
                Padding="16,8"
                Background="#FF6B6B"
                Foreground="#0F1117"
                FontWeight="SemiBold"
                BorderThickness="0"
                CornerRadius="6"/>
      </Grid>
    </Border>

    <!-- Recently Played Row -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasRecentApps}"
            Margin="0,0,0,20"
            Padding="16"
            Background="#161922"
            BorderBrush="#2A2F3E"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="🕒" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="Recently Played" FontSize="16" FontWeight="Bold" Foreground="#E8E8E8" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Jump right back in" FontSize="12" Opacity="0.6" Foreground="#E8E8E8" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentApps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AppItemViewModel">
                <Border Width="220" Background="#0F1117" BorderBrush="#2A2F3E" BorderThickness="1" CornerRadius="8" Padding="12">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <!-- Title & Last Played -->
                    <StackPanel Grid.Row="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#E8E8E8"
                                 TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Text="{Binding FormattedLastPlayed}" FontSize="11" Foreground="#00D4AA"/>
                    </StackPanel>

                    <!-- Launch Button -->
                    <Button Grid.Row="1"
                            Content="{Binding LaunchButtonText}"
                            Command="{Binding $parent[UserControl].DataContext.LaunchAppCommand}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,6"
                            Background="#00D4AA"
                            Foreground="#0F1117"
                            FontWeight="SemiBold"
                            FontSize="12"
                            CornerRadius="4"
                            IsEnabled="{Binding CanLaunch}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Empty State -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsEmpty}"
            Padding="48"
            Background="#161922"
            CornerRadius="8">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <TextBlock Text="💿" FontSize="48" HorizontalAlignment="Center"/>
        <TextBlock Text="No PS2 Game Disc Images Found" FontSize="20" FontWeight="SemiBold" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        <TextBlock Text="Configure your game folders in Settings or click Rescan to scan for .iso files."
                   FontSize="14" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="✕ Clear Filter"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding HasSearchQuery}"
                  Padding="16,10"
                  Background="#2A2F3E"
                  Foreground="#E8E8E8"
                  BorderThickness="0"
                  CornerRadius="6"
                  FontWeight="SemiBold"/>
          <Button Content="🔄 Rescan Folders"
                  Command="{Binding RescanLibraryCommand}"
                  Padding="16,10"
                  Background="#00D4AA"
                  Foreground="#0F1117"
                  BorderThickness="0"
                  CornerRadius="6"
                  FontWeight="SemiBold"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Games Grid (ListBox for native keyboard navigation) -->
    <ScrollViewer DockPanel.Dock="Top"
                  IsVisible="{Binding HasApps}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ListBox ItemsSource="{Binding Apps}"
               SelectedItem="{Binding SelectedApp}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Classes="game-card"
                    Classes.couch="{Binding $parent[UserControl].DataContext.CouchMode}"
                    ClipToBounds="True">
              <Grid RowDefinitions="180,*,Auto">
                <!-- Cover Art / Fallback Image Area -->
                <Border Grid.Row="0"
                        Background="#0F1117"
                        CornerRadius="12,12,0,0"
                        ClipToBounds="True">
                  <Grid>
                    <!-- User Cover Art Image -->
                    <Image Source="{Binding CoverArtPath, Converter={StaticResource PathToBitmapConverter}}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding HasCoverArt}"/>

                    <!-- Graceful Fallback Disc Tile -->
                    <Grid IsVisible="{Binding !HasCoverArt}">
                      <TextBlock Text="💿" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                    </Grid>

                    <!-- Cover Art Management Tools (Top Left) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                      <Button Content="🖼️"
                              ToolTip.Tip="Set or change cover art"
                              Click="OnSetCoverClick"
                              Padding="6,4"
                              Background="#30000000"
                              Foreground="#E8E8E8"
                              BorderThickness="0"
                              CornerRadius="4"
                              FontSize="12"/>
                      <Button Content="✕"
                              ToolTip.Tip="Remove cover art"
                              Click="OnRemoveCoverClick"
                              IsVisible="{Binding HasCoverArt}"
                              Padding="6,4"
                              Background="#30000000"
                              Foreground="#FF6B6B"
                              BorderThickness="0"
                              CornerRadius="4"
                              FontSize="12"/>
                    </StackPanel>

                    <!-- Running / Missing Status Badge (Top Right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="{Binding !IsMissing, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#00D4AA|#FF6B6B'}"
                            CornerRadius="10" Padding="8,3">
                      <TextBlock Text="{Binding !IsMissing, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Ready|Missing'}"
                                 FontSize="10" FontWeight="Bold" Foreground="#0F1117"/>
                    </Border>

                    <!-- File Size & Last Played Badge (Bottom) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                            Background="#80000000" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#A0A5B5" FontFamily="Consolas, Monospace"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- Game Info -->
                <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#E8E8E8"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding FormattedLastPlayed}" FontSize="11" Foreground="#00D4AA" Opacity="0.9"/>
                  <TextBlock Text="{Binding FullPath}" FontSize="11" Opacity="0.6" Foreground="#E8E8E8"
                             TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontFamily="Consolas, Monospace"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="16,0,16,16" HorizontalAlignment="Stretch">
                  <Button Content="{Binding LaunchButtonText}"
                          Command="{Binding $parent[UserControl].DataContext.LaunchAppCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Padding="0,10"
                          Background="{Binding CanLaunch, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#00D4AA|#2A2F3E'}"
                          Foreground="{Binding CanLaunch, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#0F1117|#A0A5B5'}"
                          BorderThickness="0"
                          CornerRadius="6"
                          FontWeight="SemiBold"
                          FontSize="13"
                          IsEnabled="{Binding CanLaunch}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>

    <!-- Stats Footer -->
    <Border DockPanel.Dock="Bottom" Margin="0,24,0,0" Padding="16" Background="#161922" CornerRadius="8">
      <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TotalApps}" FontSize="24" FontWeight="Bold" Foreground="#00D4AA" HorizontalAlignment="Center"/>
          <TextBlock Text="Total Games" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Background="#2A2F3E" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding InstalledApps}" FontSize="24" FontWeight="Bold" Foreground="#00D4AA" HorizontalAlignment="Center"/>
          <TextBlock Text="Ready" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Width="1" Background="#2A2F3E" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding MissingApps}" FontSize="24" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
          <TextBlock Text="Missing / Moved" FontSize="12" Opacity="0.7" Foreground="#E8E8E8" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
