<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PS2Home.App.ViewModels"
             x:Class="PS2Home.App.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" MaxWidth="800">
      <StackPanel Spacing="4">
        <TextBlock Text="Legal Downloads" FontSize="28" FontWeight="Bold" Foreground="#F4F0E6"/>
        <TextBlock Text="Get the emulator from its official source and use your own legally obtained game files."
                   FontSize="14" Opacity="0.7" Foreground="#F4F0E6" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Background="#2B2520" BorderBrush="#B9855A" BorderThickness="1" CornerRadius="10" Padding="22">
        <StackPanel Spacing="10">
          <TextBlock Text="Can PS2 games run natively on this PC?" FontSize="18" FontWeight="Bold" Foreground="#E2B978"/>
          <TextBlock Text="No. PS2 games target the PlayStation 2's Emotion Engine, I/O Processor, and graphics hardware. This project is a launcher, not a native PS2 runtime: it starts your legally obtained game image through PCSX2."
                     FontSize="13" Foreground="#F4F0E6" TextWrapping="Wrap"/>
          <TextBlock Text="For native execution, use a real PS2 console or a game-specific native port. PS2 Home cannot convert a PS2 ROM into a native Windows or Linux program."
                     FontSize="13" Foreground="#F4F0E6" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="#211E1A" BorderBrush="#3A332B" BorderThickness="1" CornerRadius="10" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="PCSX2 Emulator" FontSize="18" FontWeight="Bold" Foreground="#F4F0E6"/>
          <TextBlock Text="Download PCSX2 for Linux or Windows directly from the official PCSX2 website. PS2 Home does not redistribute emulator binaries."
                     FontSize="13" Foreground="#B7AA98" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Official PCSX2 downloads"
                    Command="{Binding OpenPcsx2DownloadsCommand}"
                    Background="#D97757" Foreground="#171513"
                    FontWeight="SemiBold" Padding="14,8" CornerRadius="6"/>
            <Button Content="Setup documentation"
                    Command="{Binding OpenPcsx2DocsCommand}"
                    Background="#3A332B" Foreground="#F4F0E6"
                    Padding="14,8" CornerRadius="6"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#2B2520" BorderBrush="#B9855A" BorderThickness="1" CornerRadius="10" Padding="22">
        <StackPanel Spacing="10">
          <TextBlock Text="Your Game Files" FontSize="18" FontWeight="Bold" Foreground="#E2B978"/>
          <TextBlock Text="PS2 Home cannot download copyrighted ROMs or ISOs. Dump or obtain game backups legally, then add their folder under Settings. The Library page will scan supported files and launch them through PCSX2."
                     FontSize="13" Foreground="#F4F0E6" TextWrapping="Wrap"/>
          <TextBlock Text="Never download or share BIOS files. PCSX2 requires a BIOS dump from your own console."
                     FontSize="13" Foreground="#F4F0E6" TextWrapping="Wrap"/>
          <TextBlock Text="Next step: open Settings → add your game folder → scan the Library."
                     FontSize="13" FontWeight="SemiBold" Foreground="#D97757" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#D97757"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
